# ==========================================
# DATAVERSE AI — ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env for local overrides if needed.
# Do NOT commit actual secrets or sensitive credentials.

# --- Frontend Application ---
PORT=5173
VITE_API_URL=http://localhost:8000/api

# --- Local Ollama Integration ---
# Dataverse AI uses a local Ollama daemon for offline generative AI insights.
# No cloud API keys or passwords are required.
VITE_OLLAMA_API_URL=http://localhost:11434
VITE_DEFAULT_OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- Backend Application ---
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
